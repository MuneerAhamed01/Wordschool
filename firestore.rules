rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------- Helpers ----------
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isDateId(id) {
      // YYYY-MM-DD
      return id.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }
    function isNonNegativeInt(n) {
      return n is int && n >= 0;
    }
    function isValidCaseOutcome(value) {
      return value == null
        || value == 'case_closed'
        || value == 'cold_case'
        || value == 'unsolved'
        || value == 'dismissed';
    }
    function isStoryClueGuessesMap(guesses) {
      return guesses is map
        && guesses.keys().hasAll(['0', '1', '2'])
        && guesses['0'] is list
        && guesses['1'] is list
        && guesses['2'] is list;
    }
    function isStoryClueGuessesList(guesses) {
      return guesses is list
        && guesses.size() == 3
        && guesses[0] is list
        && guesses[1] is list
        && guesses[2] is list;
    }
    function isStoryClueGuesses(guesses) {
      return isStoryClueGuessesMap(guesses) || isStoryClueGuessesList(guesses);
    }
    function storyClueGuessesSlotCount(guesses) {
      return guesses is map ? guesses.size() : guesses.size();
    }
    function isStoryProgressData(data) {
      return data.currentClueIndex is int
        && data.currentClueIndex >= 0
        && data.currentClueIndex <= 3
        && data.clueAttempts is list
        && data.clueAttempts.size() == 3
        && isStoryClueGuesses(data.clueGuesses)
        && data.clueSolved is list
        && data.clueSolved.size() == 3
        && isNonNegativeInt(data.totalScore)
        && data.totalScore <= 300
        && isValidCaseOutcome(data.outcome)
        && (data.completedAt == null || data.completedAt is timestamp);
    }

    // ---------- "games" (daily puzzle) ----------
    match /games/{gameId} {
      // Read allowed to anyone; IDs must look like a date.
      allow read: if isDateId(gameId);

      // Allow authenticated clients to create daily game docs with validated shape.
      allow create: if isAuthenticated()
        && isDateId(gameId)
        && request.resource.data.id == gameId
        && request.resource.data.todayWord is string
        && request.resource.data.createdDate is timestamp
        && request.resource.data.updatedDate is timestamp
        && request.resource.data.isCompleted is bool;

      // Allow guarded updates by authenticated clients; keep invariants.
      allow update: if isAuthenticated()
        && isDateId(gameId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdDate == resource.data.createdDate
        && request.resource.data.todayWord is string
        && request.resource.data.updatedDate is timestamp
        && request.resource.data.isCompleted is bool;

      // No client deletes.
      allow delete: if false;
    }

    // ---------- Per-user game state ----------
    // Root doc holds aggregates: totalGames, completedGames, streak, timestamps...
    // Subcollection holds per-day user data keyed by YYYY-MM-DD.
    match /userGameStates/{uid} {
      // Only the owner can read their state
      allow read: if isOwner(uid);

      // Create user's state document
      allow create: if isOwner(uid)
        && request.resource.data.id == uid
        && request.resource.data.createdDate is timestamp
        && request.resource.data.updatedDate is timestamp
        && isNonNegativeInt(request.resource.data.totalGames)
        && isNonNegativeInt(request.resource.data.completedGames)
        && isNonNegativeInt(request.resource.data.streak)
        && isNonNegativeInt(request.resource.data.longestStreak)
        && isNonNegativeInt(request.resource.data.detectivePoints)
        && isNonNegativeInt(request.resource.data.storyModeStreak)
        && isNonNegativeInt(request.resource.data.storyModeLongestStreak)
        && isNonNegativeInt(request.resource.data.hintPackBalance);

      // Update with sane constraints: id and createdDate immutable; counts not decreasing
      allow update: if isOwner(uid)
        && request.resource.data.id == uid
        && resource.data.id == uid
        && request.resource.data.createdDate == resource.data.createdDate
        && request.resource.data.updatedDate is timestamp
        && isNonNegativeInt(request.resource.data.totalGames)
        && isNonNegativeInt(request.resource.data.completedGames)
        && isNonNegativeInt(request.resource.data.streak)
        && isNonNegativeInt(request.resource.data.longestStreak)
        && isNonNegativeInt(request.resource.data.detectivePoints)
        && isNonNegativeInt(request.resource.data.storyModeStreak)
        && isNonNegativeInt(request.resource.data.storyModeLongestStreak)
        && request.resource.data.totalGames >= resource.data.totalGames
        && request.resource.data.completedGames >= resource.data.completedGames
        && request.resource.data.streak >= 0
        && request.resource.data.longestStreak >= resource.data.longestStreak
        && request.resource.data.detectivePoints >= resource.data.detectivePoints
        && request.resource.data.storyModeStreak >= 0
        && request.resource.data.storyModeLongestStreak >= resource.data.storyModeLongestStreak
        && request.resource.data.hintPackBalance >= 0
        && request.resource.data.hintPackBalance >= resource.data.hintPackBalance - 5;

      // Clients should not delete their state container
      allow delete: if false;

      // Per-day user data for each game day
      match /userGameData/{dateId} {
        // Only the owner can read their per-day data
        allow read: if isOwner(uid);

        // Create a per-day record only for valid date IDs
        // and only if the corresponding game document exists
        allow create: if isOwner(uid)
          && isDateId(dateId)
          && exists(/databases/$(database)/documents/games/$(dateId));

        // Updates allowed to owner; keep ID format guard
        allow update: if isOwner(uid) && isDateId(dateId);

        // Do not allow deletes from clients
        allow delete: if false;
      }
    }

    // ---------- Detective story mode ----------
    match /detectiveCases/{caseId} {
      allow read: if isDateId(caseId);
      allow create, update, delete: if false;
    }

    match /userStoryProgress/{uid} {
      allow read, write: if false;

      match /cases/{dateId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && isDateId(dateId)
          && exists(/databases/$(database)/documents/detectiveCases/$(dateId))
          && isStoryProgressData(request.resource.data);

        allow update: if isOwner(uid)
          && isDateId(dateId)
          && isStoryProgressData(request.resource.data)
          && resource.data.completedAt == null
          && request.resource.data.currentClueIndex >= resource.data.currentClueIndex
          && request.resource.data.clueAttempts.size() == resource.data.clueAttempts.size()
          && storyClueGuessesSlotCount(request.resource.data.clueGuesses)
             == storyClueGuessesSlotCount(resource.data.clueGuesses)
          && request.resource.data.clueSolved.size() == resource.data.clueSolved.size();

        allow delete: if false;
      }
    }

    // ---------- Detective weekly leaderboard (server-written) ----------
    match /detectiveLeaderboard/{weekId} {
      allow read: if isAuthenticated();
      allow write: if false;

      match /entries/{userId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    // ---------- Catch-all: deny anything not matched above ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


