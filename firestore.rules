rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------- Helpers ----------
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isDateId(id) {
      // YYYY-MM-DD
      return id.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }
    function isNonNegativeInt(n) {
      return n is int && n >= 0;
    }
    function isValidCaseOutcome(value) {
      return value == null
        || value == 'case_closed'
        || value == 'cold_case'
        || value == 'unsolved'
        || value == 'dismissed';
    }
    function isStoryClueGuessesMap(guesses) {
      return guesses is map
        && guesses.keys().hasAll(['0', '1', '2'])
        && guesses['0'] is list
        && guesses['1'] is list
        && guesses['2'] is list;
    }
    function isStoryClueGuessesList(guesses) {
      return guesses is list
        && guesses.size() == 3
        && guesses[0] is list
        && guesses[1] is list
        && guesses[2] is list;
    }
    function isStoryClueGuesses(guesses) {
      return isStoryClueGuessesMap(guesses) || isStoryClueGuessesList(guesses);
    }
    function storyClueGuessesSlotCount(guesses) {
      return guesses is map ? guesses.size() : guesses.size();
    }
    function isStoryProgressData(data) {
      return data.currentClueIndex is int
        && data.currentClueIndex >= 0
        && data.currentClueIndex <= 3
        && data.clueAttempts is list
        && data.clueAttempts.size() == 3
        && isStoryClueGuesses(data.clueGuesses)
        && data.clueSolved is list
        && data.clueSolved.size() == 3
        && isNonNegativeInt(data.totalScore)
        && data.totalScore <= 300
        && isValidCaseOutcome(data.outcome)
        && (data.completedAt == null || data.completedAt is timestamp);
    }
    function isValidNotificationPreferences(prefs) {
      return prefs is map
        && prefs.keys().hasOnly([
          'enabled',
          'dailyPuzzleEnabled',
          'detectiveCaseEnabled',
          'streakReminderEnabled',
          'dailyReminderHour',
          'streakReminderHour',
        ])
        && prefs.enabled is bool
        && prefs.dailyPuzzleEnabled is bool
        && prefs.detectiveCaseEnabled is bool
        && prefs.streakReminderEnabled is bool
        && prefs.dailyReminderHour is int
        && prefs.dailyReminderHour >= 0
        && prefs.dailyReminderHour <= 23
        && prefs.streakReminderHour is int
        && prefs.streakReminderHour >= 0
        && prefs.streakReminderHour <= 23;
    }
    function isNotificationOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['timezone', 'notifications', 'fcmTokens', 'updatedDate']);
    }
    function intOrZero(data, field) {
      return field in data && data[field] is int ? data[field] : 0;
    }
    function userGameStateCoreImmutable(uid) {
      return request.resource.data.id == uid
        && resource.data.id == uid
        && request.resource.data.createdDate == resource.data.createdDate;
    }
    function isValidUserGameStateCreate(uid) {
      return request.resource.data.id == uid
        && request.resource.data.createdDate is timestamp
        && request.resource.data.updatedDate is timestamp
        && isNonNegativeInt(request.resource.data.totalGames)
        && isNonNegativeInt(request.resource.data.completedGames)
        && isNonNegativeInt(request.resource.data.streak)
        && isNonNegativeInt(request.resource.data.longestStreak)
        && isNonNegativeInt(request.resource.data.detectivePoints)
        && isNonNegativeInt(request.resource.data.storyModeStreak)
        && isNonNegativeInt(request.resource.data.storyModeLongestStreak)
        && isNonNegativeInt(request.resource.data.hintPackBalance)
        && request.resource.data.hasRemoveAds is bool
        && request.resource.data.isDetectivePro is bool;
    }
    function isDailyStreakUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'streak', 'lastStreakDate', 'longestStreak',
          'completedGames', 'totalGames', 'updatedDate',
        ]);
    }
    function isStoryStatsUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'detectivePoints', 'storyModeStreak',
          'lastStoryModeStreakDate', 'storyModeLongestStreak', 'updatedDate',
        ]);
    }
    function isHintBalanceUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['hintPackBalance', 'updatedDate']);
    }
    function isRemoveAdsUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['hasRemoveAds', 'updatedDate']);
    }
    function isDetectiveProUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['isDetectivePro', 'hasRemoveAds', 'updatedDate']);
    }
    function isFcmTokenRemoveUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['fcmTokens', 'updatedDate']);
    }
    function isReactivateUpdate() {
      return resource.data.deletedAt != null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['deletedAt', 'updatedDate'])
        && !('deletedAt' in request.resource.data);
    }

    // ---------- "games" (daily puzzle) ----------
    match /games/{gameId} {
      // Read allowed to anyone; IDs must look like a date.
      allow read: if isDateId(gameId);

      // Allow authenticated clients to create daily game docs with validated shape.
      allow create: if isAuthenticated()
        && isDateId(gameId)
        && request.resource.data.id == gameId
        && request.resource.data.todayWord is string
        && request.resource.data.createdDate is timestamp
        && request.resource.data.updatedDate is timestamp
        && request.resource.data.isCompleted is bool;

      // Allow guarded updates by authenticated clients; keep invariants.
      allow update: if isAuthenticated()
        && isDateId(gameId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdDate == resource.data.createdDate
        && request.resource.data.todayWord is string
        && request.resource.data.updatedDate is timestamp
        && request.resource.data.isCompleted is bool;

      // No client deletes.
      allow delete: if false;
    }

    // ---------- Per-user game state ----------
    // Root doc holds aggregates: totalGames, completedGames, streak, timestamps...
    // Subcollection holds per-day user data keyed by YYYY-MM-DD.
    match /userGameStates/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid) && isValidUserGameStateCreate(uid);

      allow update: if isOwner(uid)
        && userGameStateCoreImmutable(uid)
        && isNotificationOnlyUpdate()
        && request.resource.data.updatedDate is timestamp
        && request.resource.data.timezone is string
        && isValidNotificationPreferences(request.resource.data.notifications)
        && (
          !('fcmTokens' in request.resource.data)
          || request.resource.data.fcmTokens is list
        );

      allow update: if isOwner(uid)
        && userGameStateCoreImmutable(uid)
        && isFcmTokenRemoveUpdate()
        && request.resource.data.updatedDate is timestamp
        && (
          !('fcmTokens' in request.resource.data)
          || request.resource.data.fcmTokens is list
        );

      allow update: if isOwner(uid)
        && userGameStateCoreImmutable(uid)
        && isDailyStreakUpdate()
        && request.resource.data.updatedDate is timestamp
        && isNonNegativeInt(request.resource.data.streak)
        && isNonNegativeInt(request.resource.data.longestStreak)
        && isNonNegativeInt(request.resource.data.completedGames)
        && isNonNegativeInt(request.resource.data.totalGames)
        && request.resource.data.totalGames >= intOrZero(resource.data, 'totalGames')
        && request.resource.data.completedGames >= intOrZero(resource.data, 'completedGames')
        && request.resource.data.longestStreak >= intOrZero(resource.data, 'longestStreak');

      allow update: if isOwner(uid)
        && userGameStateCoreImmutable(uid)
        && isStoryStatsUpdate()
        && request.resource.data.updatedDate is timestamp
        && isNonNegativeInt(request.resource.data.detectivePoints)
        && isNonNegativeInt(request.resource.data.storyModeStreak)
        && isNonNegativeInt(request.resource.data.storyModeLongestStreak)
        && request.resource.data.detectivePoints >= intOrZero(resource.data, 'detectivePoints')
        && request.resource.data.storyModeLongestStreak
           >= intOrZero(resource.data, 'storyModeLongestStreak');

      allow update: if isOwner(uid)
        && userGameStateCoreImmutable(uid)
        && isHintBalanceUpdate()
        && request.resource.data.updatedDate is timestamp
        && isNonNegativeInt(request.resource.data.hintPackBalance)
        && request.resource.data.hintPackBalance >= intOrZero(resource.data, 'hintPackBalance') - 1
        && request.resource.data.hintPackBalance <= intOrZero(resource.data, 'hintPackBalance') + 5;

      allow update: if isOwner(uid)
        && userGameStateCoreImmutable(uid)
        && isRemoveAdsUpdate()
        && request.resource.data.updatedDate is timestamp
        && request.resource.data.hasRemoveAds == true;

      allow update: if isOwner(uid)
        && userGameStateCoreImmutable(uid)
        && isDetectiveProUpdate()
        && request.resource.data.updatedDate is timestamp
        && request.resource.data.isDetectivePro == true
        && request.resource.data.hasRemoveAds == true;

      allow update: if isOwner(uid)
        && userGameStateCoreImmutable(uid)
        && isReactivateUpdate()
        && request.resource.data.updatedDate is timestamp;

      allow delete: if false;

      // Per-day user data for each game day
      match /userGameData/{dateId} {
        // Only the owner can read their per-day data
        allow read: if isOwner(uid);

        // Create a per-day record only for valid date IDs
        // and only if the corresponding game document exists
        allow create: if isOwner(uid)
          && isDateId(dateId)
          && exists(/databases/$(database)/documents/games/$(dateId));

        // Updates allowed to owner; keep ID format guard
        allow update: if isOwner(uid) && isDateId(dateId);

        // Do not allow deletes from clients
        allow delete: if false;
      }
    }

    // ---------- Detective story mode ----------
    match /detectiveCases/{caseId} {
      allow read: if isDateId(caseId);
      allow create, update, delete: if false;
    }

    match /userStoryProgress/{uid} {
      allow read, write: if false;

      match /cases/{dateId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && isDateId(dateId)
          && exists(/databases/$(database)/documents/detectiveCases/$(dateId))
          && isStoryProgressData(request.resource.data);

        allow update: if isOwner(uid)
          && isDateId(dateId)
          && isStoryProgressData(request.resource.data)
          && resource.data.completedAt == null
          && request.resource.data.currentClueIndex >= resource.data.currentClueIndex
          && request.resource.data.clueAttempts.size() == resource.data.clueAttempts.size()
          && storyClueGuessesSlotCount(request.resource.data.clueGuesses)
             == storyClueGuessesSlotCount(resource.data.clueGuesses)
          && request.resource.data.clueSolved.size() == resource.data.clueSolved.size();

        allow delete: if false;
      }
    }

    // ---------- Detective weekly leaderboard (server-written) ----------
    match /detectiveLeaderboard/{weekId} {
      allow read: if isAuthenticated();
      allow write: if false;

      match /entries/{userId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    // ---------- Catch-all: deny anything not matched above ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


