      "fontFamily": {
        "$type": "fontFamily",
        "$value": "Inter"
      },
      "title": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontWeight": 800,
          "fontSize": "28px",
          "lineHeight": "34px",
          "letterSpacing": "-0.02em"
        }
      },
      "heading": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontWeight": 700,
          "fontSize": "20px",
          "lineHeight": "26px"
        }
      },
      "section": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontWeight": 700,
          "fontSize": "17px",
          "lineHeight": "22px"
        }
      },
