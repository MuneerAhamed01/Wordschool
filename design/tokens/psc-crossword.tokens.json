        "surface": {
          "$type": "color",
          "$value": "#1A1A1B",
          "$description": "Cards, sheets (MyColors.gameSurface)"
        },
        "surfaceRaised": {
          "$type": "color",
          "$value": "#252526",
          "$description": "Raised tiles, icon wells (MyColors.gameSurfaceElevated)"
        },
        "sheet": {
          "$type": "color",
          "$value": "#1C1C1D",
          "$description": "Bottom sheet"
        },
        "scrim": {
          "$type": "color",
          "$value": "#0000009E",
          "$description": "Behind sheets (black 62%)"
        }
      },
      "border": {
        "default": {
          "$type": "color",
