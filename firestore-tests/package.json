{
  "name": "firestore-tests",
  "private": true,
  "description": "Firestore security rules tests (CW-010). Runs against the Firestore emulator.",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-kerala-pcs \"jest --runInBand\"",
    "test:jest": "jest --runInBand"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.1.0",
    "jest": "30.5.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 20000
  }
}
